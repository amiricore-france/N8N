        "id": "f945c6d2-a49e-497c-bf50-961439991034",
        "name": "Boucle sur chaque mail",
        "type": "n8n-nodes-base.splitInBatches",
        "typeVersion": 3,
        "position": [
          1712,
          608
        ]
      },
      {
        "parameters": {
          "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n  const binary = item.binary || {};\n  const imageKeys = Object.keys(binary).filter((k) => (binary[k].mimeType || \"\").startsWith(\"image/\"));\n\n  const base = {\n    messageId: item.json.id,\n    threadId: item.json.threadId,\n    subject: item.json.subject || \"\",\n    date: item.json.date,\n  };\n\n  if (imageKeys.length === 0) {\n    results.push({ json: { ...base, isImage: false, text: \"\" } });\n  } else {\n    for (const k of imageKeys) {\n      results.push({ json: { ...base, isImage: true }, binary: { data: binary[k] } });\n    }\n  }\n}\n\nreturn results;\n"
        },
        "id": "45a59db3-3309-42fa-8bb6-2b782b138a45",
        "name": "Extraire les pièces jointes images",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1920,
          528
        ]
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "strict",
              "version": 2
            },
            "conditions": [
              {
                "id": "cond-is-image",
                "leftValue": "={{ $json.isImage }}",
                "rightValue": true,
                "operator": {
                  "type": "boolean",
                  "operation": "true",
                  "singleValue": true
                }
              }
