      {
        "parameters": {},
        "id": "d6c62f52-65a7-468f-a6b2-4bdb102f098f",
        "name": "Fusionner les textes",
        "type": "n8n-nodes-base.merge",
        "typeVersion": 3.2,
        "position": [
          3360,
          528
        ]
      },
      {
        "parameters": {
          "jsCode": "const items = $input.all();\nconst first = items[0].json;\n\nconst texteExtrait = items\n  .map((i) => i.json.text || \"\")\n  .filter((t) => t.trim() !== \"\")\n  .join(\"\\n\")\n  .trim();\n\nconst subject = first.subject || \"\";\nconst objetMail = subject.toLowerCase();\n\nlet ville = \"\";\nif (objetMail.includes(\"pour action\") && objetMail.length > 12) {\n  ville = subject.substring(11).replace(/^[\\s\\-_:\\(\\)]+/, \"\").trim();\n}\n\nif (ville === \"\") {\n  const match = texteExtrait.match(/(\\d{5})\\s+([A-Za-zÀ-ÿ\\s\\-]+)/);\n  if (match && match[2]) {\n    ville = match[2].split(\"\\n\")[0].trim();\n  }\n}\n\nconst dateObj = first.date ? new Date(first.date) : new Date();\nconst dateStr = dateObj.toLocaleDateString(\"fr-FR\", { timeZone: \"Europe/Paris\" });\n\nconst titreTache = \"Suivi action - \" + (ville !== \"\" ? ville + \" - \" : \"\") + dateStr;\nconst texteFinal = texteExtrait === \"\" ? \"Aucun texte extrait.\" : texteExtrait;\nconst lien = \"https://mail.google.com/mail/u/0/#all/\" + first.threadId;\nconst notes = \"--- CONTENU EXTRAIT ---\\n\\n\" + texteFinal + \"\\n\\nLien : \" + lien;\n\nreturn [{\n  json: {\n    title: titreTache,\n    notes,\n    threadId: first.threadId,\n  },\n}];\n"
        },
